# Deployment settings. Copy to .env and fill in; every value has a neutral
# default in the code, so this file is where a concrete installation lives.

# --- LLM: any OpenAI-compatible endpoint -----------------------------------
# local vLLM:      http://localhost:8000/v1
# gateway/hosted:  https://<host>/v1   (then LLM_API_KEY matters)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
LLM_API_KEY=EMPTY

# --- Embeddings ------------------------------------------------------------
# local  = run the model in this process (needs a GPU)
# api    = call an OpenAI-compatible /v1/embeddings endpoint
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# only for EMBEDDING_BACKEND=api
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Profile ---------------------------------------------------------------
# Decides the app's labels and filters AND, unless the paths below are set
# explicitly, where the corpus lives: data/<profile>/<profile>.db etc.
DOCPIPE_PROFILE=kwp

# --- Corpus paths (only needed when they are not under the profile's root) --
#INFERENCE_DB_PATH=data/KWP.db
#INFERENCE_INDEX_PATH=data/faiss_index.bin
#INFERENCE_IMAGE_ROOT=data/pdf/processed
#INFERENCE_PDF_ROOT=data/pdf
