{
  "templates": [
    {
      "name": "statements",
      "label": "Ask for statements with evidence",
      "says": "The loop over the batches of an answer with the request of one batch, the sandbox and the crops beside it, as the chat asks them.",
      "group": "answer",
      "steps": [
        {
          "id": "batches",
          "each": "list",
          "list": "batches",
          "as": "batch",
          "run": "ahead",
          "stop": {
            "all": [
              {
                "of": "var",
                "is": "complete"
              },
              {
                "of": "var",
                "is": "statements",
                "op": "empty",
                "not": true
              }
            ]
          },
          "label": "🔍 Answer from the sources",
          "note": "Each batch is told the statements taken before it was asked; later batches are asked ahead where places are free and taken in order. The loop stops once the model says the answer is complete and a statement stood its check.",
          "steps": [
            {
              "id": "ask_batch",
              "box": "ask_batch"
            },
            {
              "id": "sandbox",
              "box": "compute",
              "set": {
                "runs": "asked",
                "inputs": [
                  "batch.tables"
                ]
              }
            },
            {
              "id": "crop",
              "box": "crop"
            }
          ]
        }
      ]
    },
    {
      "name": "answer",
      "label": "The answer from the hits",
      "says": "From the hits to the answer: batches, statements with evidence, repeats, figures read again, the answer, and JSON where the question wants it.",
      "group": "answer",
      "steps": [
        {
          "id": "pack",
          "box": "pack"
        },
        {
          "id": "batches",
          "each": "list",
          "list": "batches",
          "as": "batch",
          "run": "ahead",
          "stop": {
            "all": [
              {
                "of": "var",
                "is": "complete"
              },
              {
                "of": "var",
                "is": "statements",
                "op": "empty",
                "not": true
              }
            ]
          },
          "label": "🔍 Answer from the sources",
          "note": "Each batch is told the statements taken before it was asked; later batches are asked ahead where places are free and taken in order. The loop stops once the model says the answer is complete and a statement stood its check.",
          "steps": [
            {
              "id": "ask_batch",
              "box": "ask_batch"
            },
            {
              "id": "sandbox",
              "box": "compute",
              "set": {
                "runs": "asked",
                "inputs": [
                  "batch.tables"
                ]
              }
            },
            {
              "id": "crop",
              "box": "crop"
            }
          ]
        },
        {
          "id": "repeats",
          "box": "repeats"
        },
        {
          "id": "readoff",
          "box": "readoff"
        },
        {
          "id": "assemble",
          "box": "assemble"
        },
        {
          "id": "json_wanted",
          "if": [
            {
              "when": {
                "all": [
                  {
                    "of": "var",
                    "is": "as_json"
                  },
                  {
                    "of": "var",
                    "is": "answer",
                    "op": "empty",
                    "not": true
                  }
                ]
              },
              "steps": [
                {
                  "id": "format",
                  "box": "format_json"
                }
              ]
            }
          ],
          "else": []
        }
      ]
    },
    {
      "name": "harvest",
      "label": "Ask the harvest",
      "says": "The values the harvest holds for the question and the answer read from their passages, with variables of their own; it gives back the answer of the harvest.",
      "group": "routes",
      "steps": [
        {
          "id": "harvest",
          "part": {
            "gives": [
              "harvest"
            ]
          },
          "note": "The harvest answers with variables of its own: its passages, batches and statements stay inside, and only its answer comes back.",
          "steps": [
            {
              "id": "values_pick",
              "box": "values_pick"
            },
            {
              "id": "values_found",
              "note": "The passages of the values are searched in no part of the search.",
              "if": [
                {
                  "when": {
                    "all": [
                      {
                        "of": "var",
                        "is": "values_found.route",
                        "op": "is",
                        "value": "values"
                      }
                    ]
                  },
                  "steps": [
                    {
                      "id": "harvest_scopes",
                      "box": "set",
                      "set": {
                        "name": "scopes",
                        "value": []
                      }
                    },
                    {
                      "id": "values_passages",
                      "box": "values_passages"
                    },
                    {
                      "id": "harvest_found",
                      "if": [
                        {
                          "when": {
                            "all": [
                              {
                                "of": "var",
                                "is": "hits",
                                "op": "empty",
                                "not": true
                              }
                            ]
                          },
                          "steps": [
                            {
                              "id": "harvest_pack",
                              "box": "pack"
                            },
                            {
                              "id": "harvest_batches",
                              "each": "list",
                              "list": "batches",
                              "as": "batch",
                              "run": "ahead",
                              "stop": {
                                "all": [
                                  {
                                    "of": "var",
                                    "is": "complete"
                                  },
                                  {
                                    "of": "var",
                                    "is": "statements",
                                    "op": "empty",
                                    "not": true
                                  }
                                ]
                              },
                              "label": "🔍 Answer from the sources",
                              "note": "Each batch is told the statements taken before it was asked; later batches are asked ahead where places are free and taken in order. The loop stops once the model says the answer is complete and a statement stood its check.",
                              "steps": [
                                {
                                  "id": "harvest_ask_batch",
                                  "box": "ask_batch"
                                },
                                {
                                  "id": "harvest_sandbox",
                                  "box": "compute",
                                  "set": {
                                    "runs": "asked",
                                    "inputs": [
                                      "batch.tables"
                                    ]
                                  }
                                },
                                {
                                  "id": "harvest_crop",
                                  "box": "crop"
                                }
                              ]
                            },
                            {
                              "id": "harvest_repeats",
                              "box": "repeats"
                            },
                            {
                              "id": "harvest_readoff",
                              "box": "readoff"
                            },
                            {
                              "id": "harvest_assemble",
                              "box": "assemble"
                            }
                          ]
                        }
                      ],
                      "else": []
                    },
                    {
                      "id": "values_answer",
                      "box": "values_answer"
                    }
                  ]
                }
              ],
              "else": []
            }
          ]
        }
      ]
    },
    {
      "name": "graph",
      "label": "Ask the graph",
      "says": "The plan in the graph, the field and its dimensions, the query built and run, and the values with their evidence.",
      "group": "routes",
      "steps": [
        {
          "id": "graph_plan",
          "box": "graph_plan"
        },
        {
          "id": "graph_known",
          "if": [
            {
              "when": {
                "all": [
                  {
                    "of": "var",
                    "is": "graph",
                    "op": "empty"
                  }
                ]
              },
              "steps": [
                {
                  "id": "graph_coordinates",
                  "box": "graph_coordinates"
                },
                {
                  "id": "graph_named",
                  "if": [
                    {
                      "when": {
                        "all": [
                          {
                            "of": "var",
                            "is": "graph",
                            "op": "empty"
                          }
                        ]
                      },
                      "steps": [
                        {
                          "id": "graph_build",
                          "box": "graph_build"
                        },
                        {
                          "id": "graph_query",
                          "box": "graph_query",
                          "set": {
                            "bindings": "bindings"
                          }
                        },
                        {
                          "id": "graph_values",
                          "box": "graph_values"
                        }
                      ]
                    }
                  ],
                  "else": []
                }
              ]
            }
          ],
          "else": []
        }
      ]
    },
    {
      "name": "compare",
      "label": "Compare the documents",
      "says": "Each document chosen with its own search and answer, side by side, then one request that compares the answers.",
      "group": "routes",
      "steps": [
        {
          "id": "compare_kept",
          "box": "compare_kept"
        },
        {
          "id": "each_document",
          "each": "list",
          "list": "compared",
          "as": "document",
          "run": "side_by_side",
          "collect": {
            "from": "row",
            "into": "rows"
          },
          "note": "Each document has its own search, its own batches and its own citations, with its own turns before; the picture of the question is no anchor here.",
          "steps": [
            {
              "id": "document_history",
              "box": "set",
              "set": {
                "name": "history",
                "from": "document.history"
              }
            },
            {
              "id": "no_image",
              "box": "set",
              "set": {
                "name": "image",
                "value": null
              }
            },
            {
              "id": "no_image_only",
              "box": "set",
              "set": {
                "name": "image_only",
                "value": false
              }
            },
            {
              "id": "document_phrase",
              "box": "phrase"
            },
            {
              "id": "document_embed",
              "box": "embed"
            },
            {
              "id": "document_search",
              "box": "search"
            },
            {
              "id": "document_found",
              "if": [
                {
                  "when": {
                    "all": [
                      {
                        "of": "var",
                        "is": "hits",
                        "op": "empty",
                        "not": true
                      }
                    ]
                  },
                  "steps": [
                    {
                      "id": "document_pack",
                      "box": "pack"
                    },
                    {
                      "id": "document_batches",
                      "each": "list",
                      "list": "batches",
                      "as": "batch",
                      "run": "ahead",
                      "stop": {
                        "all": [
                          {
                            "of": "var",
                            "is": "complete"
                          },
                          {
                            "of": "var",
                            "is": "statements",
                            "op": "empty",
                            "not": true
                          }
                        ]
                      },
                      "label": "🔍 Answer from the sources",
                      "note": "Each batch is told the statements taken before it was asked; later batches are asked ahead where places are free and taken in order. The loop stops once the model says the answer is complete and a statement stood its check.",
                      "steps": [
                        {
                          "id": "document_ask_batch",
                          "box": "ask_batch"
                        },
                        {
                          "id": "document_sandbox",
                          "box": "compute",
                          "set": {
                            "runs": "asked",
                            "inputs": [
                              "batch.tables"
                            ]
                          }
                        },
                        {
                          "id": "document_crop",
                          "box": "crop"
                        }
                      ]
                    },
                    {
                      "id": "document_repeats",
                      "box": "repeats"
                    },
                    {
                      "id": "document_readoff",
                      "box": "readoff"
                    },
                    {
                      "id": "document_assemble",
                      "box": "assemble"
                    },
                    {
                      "id": "document_json_wanted",
                      "if": [
                        {
                          "when": {
                            "all": [
                              {
                                "of": "var",
                                "is": "as_json"
                              },
                              {
                                "of": "var",
                                "is": "answer",
                                "op": "empty",
                                "not": true
                              }
                            ]
                          },
                          "steps": [
                            {
                              "id": "document_format",
                              "box": "format_json"
                            }
                          ]
                        }
                      ],
                      "else": []
                    }
                  ]
                }
              ],
              "else": []
            },
            {
              "id": "document_answer",
              "box": "document_answer"
            }
          ]
        },
        {
          "id": "compare_answers",
          "box": "compare_answers"
        }
      ]
    },
    {
      "name": "compute",
      "label": "Compute",
      "says": "The model writes Python from the statements, the sandbox runs it, and what it printed is the answer.",
      "group": "logic",
      "steps": [
        {
          "id": "compute_code",
          "box": "ask",
          "set": {
            "prompt": "Write Python that answers the question from the statements. Print the result. Question: {{question}}",
            "inputs": [
              "statements"
            ],
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "code"
              ]
            },
            "into": "code_reply"
          }
        },
        {
          "id": "compute_run",
          "box": "compute",
          "set": {
            "code_from": "code_reply.code",
            "inputs": [
              "statements"
            ]
          }
        },
        {
          "id": "compute_answer",
          "box": "format_template",
          "set": {
            "text": "{{computed.stdout}}"
          }
        }
      ]
    }
  ]
}
