{
  "classes": {},
  "constraints": {},
  "rules": {
    "base": "https://openenergyplatform.org/id/mhpkg/",
    "rounding_tolerance": 0.02,
    "drawn_tolerance": 0.1,
    "contested_in_full": true,
    "pick_one_order": [
      "not_contained",
      "most_sources",
      "located",
      "longer"
    ],
    "settle_order": [
      "wording",
      "rounding",
      "trust",
      "contested"
    ],
    "corroborated_by_place": true
  },
  "map": {
    "prefixes": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "obo": "http://purl.obolibrary.org/obo/",
      "mhpo": "https://purl.org/mhpo/ontology/",
      "oeo": "https://openenergyplatform.org/ontology/oeo/"
    },
    "prefix_width": 6,
    "legal_forms": "(gmbh\\s*&\\s*co\\.?\\s*kg|gmbh|mbh|ag|kg|ohg|e\\.?\\s*v\\.?|gbr|se|ug)",
    "document": {
      "facts": {
        "preset": "plan_register",
        "python": "def run(call):\n    \"\"\"The plan in the register: its AGS, its publication date and its\n    municipality ({ags}, {published}, {year}, {place}); a plan without AGS\n    or date is not written.\"\"\"\n    doc = call.doc\n    identity = kg.document_identity(doc.writer.db_path, doc.name)\n    if identity is None:\n        log.warning(\"graph: %s: no AGS or publication date -- %d tuple(s) \"\n                    \"not written\", doc.name,\n                    sum(len(rows) for rows in doc.admitted.values()))\n        return None\n    return kg.facts_of(identity)\n"
      },
      "strict": true,
      "claims": {
        "preset": "value_bodies",
        "python": "def run(call):\n    \"\"\"For the provenance file, the node or class each dimension of a\n    number became.\"\"\"\n    doc, row = call.doc, call.node.row\n    said = call.settings\n    total = kg.totals(doc.writer.drawing.raw, said.get(\"box\", \"value\"))\n    whole = (doc.nodes.get(said.get(\"whole\", \"municipality\")) or [None])[0]\n    area = whole.iri if whole else None\n    if row.get(\"spatial_scope\") == \"sub_area\":\n        node = doc.node_of(said.get(\"area\", \"area\"),\n                           doc.fold(row[\"spatial_scope_raw\"]))\n        area = node.iri if node else area\n    found = {\"quantity\": kg.class_iri(row.get(\"quantity\")),\n             \"carrier\": kg.class_iri(kg.written(row, \"carrier\", total)),\n             \"sector\": kg.class_iri(kg.written(row, \"sector\", total)),\n             \"technology\": kg.class_iri(row.get(\"technology\")),\n             \"aggregation\": kg.class_iri(row.get(\"aggregation\")),\n             \"scenario\": doc.address_of_answer(said.get(\"part\", \"part\"),\n                                               row[\"scenario\"]),\n             \"spatial_scope\": area}\n    return {axis: iri for axis, iri in found.items() if iri}\n",
        "settings": {
          "part": "part",
          "area": "area",
          "whole": "municipality",
          "box": "value"
        },
        "document": "plan",
        "box": "value"
      }
    },
    "boxes": [
      {
        "id": "plan",
        "class": "mhpo:MHPO_00020003",
        "count": "per_document",
        "same_node": "refuse",
        "address": {
          "folder": "heatplan",
          "name": "AGS_{ags}_{published}"
        },
        "note": "One node per plan, named by its register key and its full publication date. A second document with the same key is refused whole (a stale duplicate harvest)."
      },
      {
        "id": "part",
        "count": "per_answer",
        "of": "scenario",
        "among": "value",
        "table": {
          "status_quo": {
            "class": "mhpo:MHPO_00020005",
            "folder": "inventoryanalysis",
            "label": "Bestandsanalyse",
            "schema_class": "AggregatedInventoryAnalysis"
          },
          "trend": {
            "class": "oeo:OEO_00020311",
            "folder": "referencescenario",
            "label": "Trendszenario",
            "note": "with existing measures scenario. Not OEO_00020314 reference scenario: that one is defined by a ROLE (`scenario and has role some reference role`) and carries no content, so it says a scenario was used as a comparison and not what it assumes. A Trendszenario is the continuation under the measures already decided, which is what WEM means."
          },
          "target": {
            "class": "mhpo:MHPO_00020007",
            "folder": "targetscenario",
            "label": "Zielszenario",
            "schema_class": "TargetScenario"
          }
        },
        "address": {
          "name": "AGS_{ags}_{published}"
        },
        "strict": {
          "requires": [
            "target"
          ]
        },
        "note": "Which part of the plan holds a value: one node for each scenario the document's values are read in (inventory, trend, target; the table gives each its class, folder and label). The plan reaches it by the arrow plan -> part, the part its values by the arrow part -> value. The strict graph keeps only the parts the MHPKG schema has (schema_class) and leaves out a document without a target scenario (strict, requires)."
      },
      {
        "id": "value",
        "count": "per_value",
        "of": [
          "energy_consumption",
          "emission",
          "heat_load",
          "share",
          "building_count"
        ],
        "required": true,
        "admit": [
          {
            "preset": "quantity_listed",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "quantity",
                  "op": "listed"
                }
              ]
            },
            "reason": "not_a_class:{quantity|quantity_raw|'?'}"
          },
          {
            "preset": "scenario_read",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "scenario",
                  "op": "empty",
                  "not": true
                }
              ]
            },
            "reason": "scenario_unread"
          },
          {
            "preset": "part_known",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "scenario",
                  "op": "answer_of",
                  "value": "part"
                }
              ]
            },
            "reason": "scenario:{scenario}"
          },
          {
            "preset": "scope_listed",
            "if": {
              "any": [
                {
                  "of": "reading",
                  "is": "spatial_scope",
                  "op": "empty"
                },
                {
                  "of": "reading",
                  "is": "spatial_scope",
                  "op": "one_of",
                  "value": [
                    "municipality",
                    "sub_area"
                  ]
                }
              ]
            },
            "reason": "spatial_scope"
          },
          {
            "preset": "sub_area_named",
            "if": {
              "any": [
                {
                  "of": "reading",
                  "is": "spatial_scope",
                  "op": "is",
                  "value": "sub_area",
                  "not": true
                },
                {
                  "of": "reading",
                  "is": "spatial_scope_raw",
                  "op": "empty",
                  "not": true
                }
              ]
            },
            "reason": "sub_area_unnamed"
          },
          {
            "preset": "year_read",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "year",
                  "op": "whole"
                }
              ]
            },
            "reason": "year"
          },
          {
            "preset": "unit_listed",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "value_target",
                  "op": "empty",
                  "not": true
                }
              ]
            },
            "reason": "unit_unlisted:{unit_raw|'?'}"
          },
          {
            "preset": "unit_in_ontology",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "quantity",
                  "op": "listed"
                },
                {
                  "of": "reading",
                  "is": "unit_target",
                  "op": "term"
                }
              ]
            },
            "reason": "unit_not_in_ontology:{unit_target}"
          },
          {
            "preset": "aggregation_listed",
            "if": {
              "any": [
                {
                  "of": "reading",
                  "is": "aggregation",
                  "op": "empty"
                },
                {
                  "of": "reading",
                  "is": "aggregation",
                  "op": "listed"
                }
              ]
            },
            "reason": "aggregation:{aggregation}"
          },
          {
            "brick": "schema_admits",
            "graph": "strict",
            "settings": {
              "part": "part",
              "box": "value"
            }
          }
        ],
        "address": {
          "preset": "value_identity",
          "folder": "value",
          "key": "value",
          "from": [
            {
              "from": "answer_address",
              "box": "part",
              "of": "scenario",
              "absent": "empty"
            },
            {
              "of": "quantity",
              "form": "iri",
              "prefix": "oeo"
            },
            {
              "of": "carrier",
              "total": true,
              "form": "class",
              "prefix": "oeo",
              "family": "OEO_",
              "absent": "empty"
            },
            {
              "of": "sector",
              "total": true,
              "form": "class",
              "prefix": "oeo",
              "family": "OEO_",
              "absent": "empty"
            },
            {
              "of": "year",
              "form": "text",
              "absent": "empty"
            },
            {
              "of": "aggregation",
              "form": "iri",
              "prefix": "oeo",
              "absent": "empty"
            },
            {
              "of": "spatial_scope_raw",
              "when": {
                "all": [
                  {
                    "of": "reading",
                    "is": "spatial_scope",
                    "op": "is",
                    "value": "sub_area"
                  }
                ]
              },
              "form": "fold",
              "absent": "empty"
            },
            {
              "of": "technology",
              "form": "class",
              "prefix": "oeo",
              "family": "OEO_",
              "absent": "omit"
            },
            {
              "from": "wording",
              "absent": "omit"
            }
          ]
        },
        "settle": {
          "wording": [
            "subject",
            "whole",
            "carrier_raw",
            "sector_raw"
          ]
        },
        "class_brick": {
          "preset": "value_class",
          "python": "def run(call):\n    \"\"\"The class the quantity was read as, and in the strict graph also the\n    schema's value class above it.\"\"\"\n    row = call.node.row\n    typed = kg.qualified(row[call.settings.get(\"coordinate\", \"quantity\")])\n    if not call.doc.strict:\n        return typed\n    part = call.doc.writer.drawing.box[call.settings.get(\"part\", \"part\")]\n    schema = kg.schema_class_of(row, part.get(\"table\") or {})\n    if schema and kg.SHAPE.cls(schema) != typed:\n        # A CO2-equivalent value IS a greenhouse gas emission value; a shape\n        # without a reasoner only sees the class written.\n        typed += f\", {kg.SHAPE.cls(schema)}\"\n    return typed\n",
          "settings": {
            "part": "part",
            "coordinate": "quantity"
          }
        },
        "evidence": {
          "preset": "value_passage",
          "python": "def run(call):\n    \"\"\"Above a number its dimensions in English, the passage, the page, how\n    it was aggregated or computed and its trust level.\"\"\"\n    node = call.node\n    return kg.evidence_comment(node.row, call.doc.name,\n                               call.settings.get(\"prose\") or {},\n                               call.settings.get(\"join\") or \" · \",\n                               transcribed=call.doc.transcribed,\n                               **(node.data.get(\"marks\") or {}))\n",
          "settings": {
            "prose": {
              "level": "Trust: {level}",
              "image_origin": "from an image",
              "image_origin_named": "from an image ({image})",
              "corroborated": "confirmed by a second reading",
              "reasons": "{reasons}",
              "review": "review recommended"
            },
            "join": " · "
          }
        }
      },
      {
        "id": "office",
        "class": "oeo:OEO_00030022",
        "count": "per_distinct",
        "of": "planning_organisation",
        "when": [
          {
            "preset": "answer_is_not",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "role",
                  "op": "is",
                  "value": "municipality",
                  "not": true
                }
              ]
            },
            "reason": "role:{role}"
          },
          {
            "preset": "named",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "value",
                  "op": "names"
                }
              ]
            },
            "reason": "unnamed"
          }
        ],
        "name_brick": {
          "brick": "without_legal_form"
        },
        "once": "per_file",
        "address": {
          "folder": "organisation",
          "key": "organisation",
          "from": [
            "@key"
          ]
        },
        "note": "The MHPKG schema: a municipality acting as planning authority is NOT a second entity, so `municipality` links has_organisation to the plan's municipality node; `planner` mints an Organisation."
      },
      {
        "id": "area",
        "class": "mhpo:MHPO_00020019",
        "count": "per_distinct",
        "among": "value",
        "value": "spatial_scope_raw",
        "when": [
          {
            "preset": "answer_is",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "spatial_scope",
                  "op": "is",
                  "value": "sub_area"
                }
              ]
            },
            "reason": "spatial_scope:{spatial_scope}"
          },
          {
            "preset": "has_words",
            "if": {
              "all": [
                {
                  "of": "reading",
                  "is": "spatial_scope_raw",
                  "op": "empty",
                  "not": true
                }
              ]
            },
            "reason": "spatial_scope_raw_unnamed"
          }
        ],
        "name": "last",
        "name_brick": {
          "brick": "trimmed"
        },
        "order": "sorted",
        "address": {
          "folder": "heatplanarea",
          "key": "heatplanarea",
          "from": [
            "@fact:ags",
            "@key"
          ]
        },
        "note": "The schema has no relation from a value to its area, so a sub_area value is serialized with the area in its IRI and its comment but without an edge to the area node. Not TERM REQUEST 1, which asks for the plan's area."
      },
      {
        "id": "municipality",
        "class": "mhpo:MHPO_00020017",
        "count": "per_document",
        "address": {
          "folder": "municipality",
          "name": "AGS_{ags}"
        },
        "note": "the plan's own area, minted from the AGS"
      }
    ],
    "arrows": [
      {
        "from": "plan",
        "to": "plan",
        "property": "rdfs:label",
        "brick": "template",
        "settings": {
          "text": "Kommunale Wärmeplanung {place} {year}"
        }
      },
      {
        "from": "plan",
        "to": "plan",
        "property": "oeo:OEO_00390096",
        "brick": "fact",
        "settings": {
          "fact": "published",
          "datatype": "xsd:date"
        }
      },
      {
        "from": "plan",
        "to": "office",
        "property": "oeo:OEO_00000510",
        "objects": "joined",
        "label": "has organisation"
      },
      {
        "from": "plan",
        "to": "municipality",
        "property": "oeo:OEO_00000510",
        "objects": "joined",
        "when": {
          "field": "planning_organisation",
          "coordinate": "role",
          "is": "municipality"
        },
        "note": "The schema: a municipality acting as planning authority is not a second entity, so the plan's municipality node is its organisation."
      },
      {
        "from": "plan",
        "to": "part",
        "property": "obo:BFO_0000051",
        "objects": "joined",
        "label": "has part"
      },
      {
        "from": "part",
        "to": "part",
        "property": "rdfs:label",
        "brick": "template",
        "settings": {
          "text": "{label} {place} {year}"
        }
      },
      {
        "from": "part",
        "to": "value",
        "property": "mhpo:MHPO_0002028",
        "objects": "joined"
      },
      {
        "from": "value_target",
        "to": "value",
        "property": "oeo:OEO_00140178",
        "brick": "decimal",
        "label": "has number"
      },
      {
        "from": "unit_target",
        "to": "value",
        "property": "oeo:OEO_00040010",
        "brick": {
          "preset": "value_unit",
          "steps": [
            {
              "brick": "answer_class",
              "settings": {
                "prefix_by_family": {
                  "OEO_": "oeo",
                  "MHPO_": "mhpo",
                  "BFO_": "obo",
                  "UO_": "obo"
                }
              }
            }
          ],
          "writes": "key:unit_target"
        },
        "label": "has unit"
      },
      {
        "from": "carrier",
        "to": "value",
        "property": "oeo:OEO_00370001",
        "brick": "answer_class",
        "settings": {
          "prefix": "oeo",
          "family": "OEO_",
          "outside_root": {
            "OEO_00000132": "district heating",
            "OEO_00000139": "electrical energy",
            "OEO_00000388": "solar thermal energy",
            "OEO_00000191": "geothermal energy",
            "OEO_00010114": "waste heat",
            "OEO_00310004": "industrial waste heat",
            "OEO_00000056": "ambient heat",
            "OEO_00140105": "waste water heat",
            "OEO_00140104": "surface water heat"
          }
        },
        "label": "refers to energy carrier",
        "note": "Object is an OEO class (punning). The predicate is the MHPKG schema's slot, read from mhpkg_schema.yaml at serialization: refers to energy carrier. Its range is energy carrier, and the classes in outside_root are not under it in OEO; they are written all the same and counted, as input for the carrier axioms the ontology side is adding."
      },
      {
        "from": "sector",
        "to": "value",
        "property": "oeo:OEO_00020519",
        "brick": "answer_class",
        "settings": {
          "prefix": "oeo",
          "family": "OEO_",
          "total_class": "OEO_00000128"
        },
        "label": "refers to sector",
        "note": "Object is an OEO sector class. The predicate is the MHPKG schema's slot, read from mhpkg_schema.yaml at serialization. A number its table does not split by sector (out:total) is written as total_class, the parent the schema names for a figure reported without a sector breakdown."
      },
      {
        "from": "technology",
        "to": "value",
        "property": "oeo:OEO_00370003",
        "brick": "answer_class",
        "settings": {
          "prefix": "oeo",
          "family": "OEO_"
        },
        "label": "refers to technology",
        "note": "Object is an OEO heat generation technology class (punning), the MHPKG schema's slot. A number not split by technology (out:total) writes no edge: the schema's slot is optional."
      },
      {
        "from": "year",
        "to": "value",
        "property": "oeo:OEO_00020440",
        "brick": "whole_number",
        "label": "has scenario year value",
        "note": "The calendar year as an integer literal, as the MHPKG schema's slot has it. A unit entry that names no period carries the flag period:unstated."
      },
      {
        "from": "aggregation",
        "to": "value",
        "property": "oeo:OEO_00390023",
        "brick": "answer_class",
        "settings": {
          "prefix": "oeo"
        },
        "label": "has aggregation type",
        "note": "Object is a named individual of OEO_00140068 aggregation type. Asked; where no answer is read, derived from a unit that converts onto the parameter's own unit."
      },
      {
        "from": "planning_organisation",
        "to": "office",
        "property": "rdfs:label",
        "brick": "node_name",
        "settings": {
          "form": "line"
        }
      },
      {
        "from": "spatial_scope_raw",
        "to": "area",
        "property": "rdfs:label",
        "brick": "node_name",
        "settings": {
          "form": "line"
        }
      },
      {
        "from": "area",
        "to": "municipality",
        "property": "obo:BFO_0000050",
        "label": "part of"
      },
      {
        "from": "municipality",
        "to": "municipality",
        "property": "rdfs:label",
        "brick": "template",
        "settings": {
          "text": "Gemeindegebiet {place}"
        }
      }
    ]
  }
}
