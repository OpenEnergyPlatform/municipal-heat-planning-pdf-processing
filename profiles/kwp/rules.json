{
  "rules": {
    "decimal_mark": ",",
    "year_range": [
      1900,
      2100
    ],
    "span_marks": {
      "qualifier": "out:approximate"
    },
    "context_sentence": true,
    "value_bounds": [
      {
        "parameter": "share",
        "at_most": "100"
      }
    ],
    "part_of_whole": {
      "carrier": "out:total",
      "sector": "out:total",
      "technology": "out:total"
    },
    "hyphen_exceptions": [
      "und",
      "oder",
      "bzw",
      "etc",
      "sowie",
      "als",
      "wie",
      "auch",
      "denn",
      "noch",
      "sondern",
      "doch",
      "jedoch",
      "allerdings",
      "hingegen",
      "beziehungsweise",
      "insbesondere",
      "zum",
      "zur",
      "im",
      "in",
      "am",
      "an",
      "auf",
      "von",
      "mit",
      "für",
      "über",
      "unter",
      "zwischen",
      "ohne",
      "gegen",
      "bis",
      "durch",
      "trotz",
      "wegen",
      "während"
    ],
    "heading_excluded_prefixes": [
      "abbildung",
      "abb.",
      "tabelle",
      "tab."
    ],
    "caption_max_words": 45,
    "directory_figure_words": [
      "Abbildung",
      "Tabelle",
      "Abb\\.",
      "Tab\\."
    ],
    "bibliography_title_words": [
      "literatur",
      "quellen",
      "referenz",
      "bibliograf"
    ],
    "caption_opener_patterns": [
      "(?:^|(?<=[\\s\\]]))([A-ZÄÖÜ][A-Za-zÄÖÜäöüß.]{2,14}\\s+\\d+(?:[-.–]\\d+)*\\s*:)"
    ],
    "front_section_title": "Dokument",
    "part_section_title": "Abschnitt",
    "compute_parts": {
      "carrier": "out:total",
      "sector": "out:total",
      "technology": "out:total",
      "spatial_scope": "municipality"
    },
    "computed_same_once": "on",
    "compute_least_parts": 2,
    "sum_printed_least_numbers": 3,
    "shown_number_places": 6,
    "compute_zero_counts": false,
    "compute_needs_frame": true,
    "compute_out_quantity_counts": false,
    "share_ask_without_whole": true,
    "compute_mixed_qualifier": "out:approximate",
    "frame_axes": [
      "scenario",
      "year"
    ],
    "alt_label_language": "de",
    "contract_language": "de",
    "prompt_checks": []
  }
}
