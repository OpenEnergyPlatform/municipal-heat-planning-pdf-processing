    "regions": {
      "kind": "sparql",
      "endpoint": "https://openenergyplatform.org/api/v0/oekg/sparql/",
      "token_env": "OEP_API_TOKEN",
      "query": "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nSELECT DISTINCT ?region ?label WHERE {\n  ?region ?p ?o .\n  FILTER(STRSTARTS(STR(?region), \"https://openenergyplatform.org/ontology/oekg/region/\"))\n  OPTIONAL { ?region rdfs:label ?label }\n}"
    },
    "oekg_context": {
      "kind": "sparql",
      "endpoint": "https://openenergyplatform.org/api/v0/oekg/sparql/",
      "token_env": "OEP_API_TOKEN",
      "query": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nSELECT ?s ?p ?o WHERE {\n  VALUES ?p { rdf:type rdfs:label }\n  ?s ?p ?o .\n  FILTER(STRSTARTS(STR(?s), \"https://openenergyplatform.org/ontology/oekg/region/\")\n         || STRSTARTS(STR(?s), \"https://openenergyplatform.org/ontology/oeo/\"))\n}"
    },
